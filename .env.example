# Supabase → Project Settings → API. The anon/publishable key is safe in the browser:
# every table is protected by row-level security. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: show "Continue with Google" for students once Google is enabled in Supabase → Authentication → Providers.
# VITE_GOOGLE_SIGN_IN=true
